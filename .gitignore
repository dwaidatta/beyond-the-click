# Beyond the Click — no build step, so almost everything here is source.
# The sprite PNGs under assets/characters/ ARE committed: they are the
# shipped art, and build_sprites.py only regenerates them on demand.

# --- OS cruft ---
.DS_Store
._*
Thumbs.db
ehthumbs.db
desktop.ini

# --- editors ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- python (assets/characters/build_sprites.py) ---
__pycache__/
*.py[cod]
.venv/
venv/
env/

# --- node, if tooling is ever added ---
node_modules/
npm-debug.log*
yarn-error.log*

# --- scratch ---
*.log
.tmp/
tmp/
